    },
    {
      "id": "module-colors",
      "type": "replaceable-media",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "chapter-copy",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "system-ledger",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "motion-keyframes",
      "type": "motion-config",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    }
  ],
  "compatibility": {
    "webmotion": ">=0.1.0",
    "browser": "Modern browser with WebGL2 recommended; readable fallback required",
    "framework": "Framework-neutral contract with a react-r3f adapter"
  },
