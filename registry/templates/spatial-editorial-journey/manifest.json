{
  "schemaVersion": 1,
  "id": "spatial-editorial-journey",
  "name": "Spatial Editorial Journey",
  "version": "0.1.0",
  "availability": "adapter",
  "license": "CC0-1.0",
  "provenance": "Original WebMotion framework-neutral contract, React Three Fiber adapter, generated demonstration imagery, fictional copy, and procedural 3D. No third-party brand assets, source-site media, or copied implementation code are included.",
  "experience": {
    "category": "guided-spatial-journey",
    "capabilities": [
      "continuous-scroll-state",
      "2d-to-3d-terrain-morph",
      "vertical-to-horizontal-traverse",
      "shared-camera-boundary-keyframes",
      "delta-damped-camera-and-gaze",
      "distinct-editorial-chapter-compositions",
      "semantic-procedural-3d",
      "bilingual-content",
      "independent-mobile-trajectory",
      "reduced-motion-fallback"
    ]
  },
  "adapters": [
    {
      "id": "react-r3f",
      "available": true,
      "path": "adapters/react-r3f",
      "entry": "adapters/react-r3f/src/main.jsx",
      "compatibility": {
        "react": ">=19.0.0 <20",
        "reactThreeFiber": ">=9.0.0 <10",
        "three": ">=0.185.0 <0.186.0",
        "vite": ">=8.0.0 <9"
      }
    }
  ],
  "assetSlots": [
    {
      "id": "source-image",
      "type": "image",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/assets.config.js#source"
    },
    {
      "id": "traverse-image",
      "type": "image",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/assets.config.js#traverse"
    },
    {
      "id": "closing-image",
      "type": "image",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/assets.config.js#estuary"
    },
    {
      "id": "chapter-copy",
      "type": "localized-text",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/content.js"
    },
    {
      "id": "camera-trajectories",
      "type": "motion-config",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/motion.config.js"
    },
    {
      "id": "brand-fonts",
      "type": "font",
      "required": false,
      "distribution": "user-supplied"
    }
  ],
  "compatibility": {
    "webmotion": ">=0.1.0",
    "browser": "Modern browser with WebGL2 recommended; readable reduced-motion content remains required",
    "framework": "Framework-neutral contract with a verified React Three Fiber adapter"
  },
  "entrypoints": {
    "contract": "contract.json",
    "configExample": "config.example.json",
    "configSchema": "schema/config.schema.json",
    "qa": "qa/checkpoints.json",
    "adapter": "adapters/react-r3f"
  },
