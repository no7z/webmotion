{
  "schemaVersion": 1,
  "id": "narrative-spatial-handoff",
  "name": "Narrative Spatial Handoff",
  "version": "0.1.0",
  "availability": "adapter",
  "license": "CC0-1.0",
  "provenance": "Original WebMotion contract, fictional bilingual content, procedural visuals, and adapter code. No third-party brand assets or copied implementation code.",
  "experience": {
    "spec": "E06",
    "category": "narrative-to-spatial-index",
    "capabilities": [
      "two-act-interaction",
      "explicit-control-handoff",
      "scroll-narrative",
      "click-spatial-index",
      "synchronized-selection-record",
      "keyboard-hotspots",
      "mobile-index-serialization"
    ]
  },
  "adapters": [
    {
      "id": "react-r3f",
      "available": true,
      "path": "adapters/react-r3f",
      "entry": "adapters/react-r3f/src/main.jsx",
      "compatibility": {
        "react": ">=19 <20",
        "reactThreeFiber": ">=9 <10",
        "three": ">=0.185 <0.186",
        "vite": ">=8 <9"
      }
    }
  ],
  "assetSlots": [
    {
      "id": "narrative-copy",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "spatial-base",
      "type": "replaceable-media",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "hotspot-records",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "selection-camera-poses",
      "type": "motion-config",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    }
  ],
  "compatibility": {
    "webmotion": ">=0.1.0",
    "browser": "Modern browser with WebGL2 recommended; readable fallback required",
    "framework": "Framework-neutral contract with a react-r3f adapter"
  },
  "entrypoints": {
    "contract": "contract.json",
    "configExample": "config.example.json",
    "configSchema": "schema/config.schema.json",
    "qa": "qa/checkpoints.json",
    "adapter": "adapters/react-r3f"
  },
