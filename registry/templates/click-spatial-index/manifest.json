{
  "schemaVersion": 1,
  "id": "click-spatial-index",
  "name": "Click Spatial Index",
  "version": "0.1.0",
  "availability": "adapter",
  "license": "CC0-1.0",
  "provenance": "Original WebMotion contract, fictional bilingual content, procedural visuals, and adapter code. No third-party brand assets or copied implementation code.",
  "experience": {
    "spec": "E09",
    "category": "non-scroll-spatial-navigation",
    "capabilities": [
      "direct-spatial-selection",
      "hierarchical-floor-room-index",
      "synchronized-model-record",
      "no-scroll-navigation",
      "keyboard-room-controls",
      "mobile-index-stack",
      "reduced-motion-direct-selection"
    ]
  },
  "adapters": [
    {
      "id": "react-r3f",
      "available": true,
      "path": "adapters/react-r3f",
      "entry": "adapters/react-r3f/src/main.jsx",
      "compatibility": {
        "react": ">=19 <20",
        "reactThreeFiber": ">=9 <10",
        "three": ">=0.185 <0.186",
        "vite": ">=8 <9"
      }
    }
  ],
  "assetSlots": [
    {
      "id": "building-model",
      "type": "replaceable-media",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "floor-records",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "room-records",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "selection-camera-poses",
      "type": "motion-config",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    }
  ],
  "compatibility": {
    "webmotion": ">=0.1.0",
    "browser": "Modern browser with WebGL2 recommended; readable fallback required",
    "framework": "Framework-neutral contract with a react-r3f adapter"
  },
