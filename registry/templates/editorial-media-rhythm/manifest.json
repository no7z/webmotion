    "spec": "E07",
    "category": "editorial-media-choreography",
    "capabilities": [
      "editorial-density-choreography",
      "bounded-spatial-insert",
      "ordinary-document-flow",
      "asymmetric-spreads",
      "touch-media-cabinet",
      "no-persistent-scene",
      "reduced-motion-document"
    ]
  },
  "adapters": [
