{
  "schemaVersion": 1,
  "id": "fullscreen-state-machine",
  "name": "Fullscreen State Machine",
  "version": "0.1.0",
  "availability": "adapter",
  "license": "CC0-1.0",
  "provenance": "Original WebMotion contract, fictional bilingual content, procedural visuals, and adapter code. No third-party brand assets or copied implementation code.",
  "experience": {
    "spec": "E03",
    "category": "internal-fullscreen-state-machine",
    "capabilities": [
      "internal-scroll-owner",
      "discrete-fullscreen-states",
      "persistent-object",
      "synchronized-copy-camera-state",
      "explicit-exit",
      "keyboard-stage-navigation",
      "mobile-stage-recomposition"
    ]
  },
  "adapters": [
    {
      "id": "react-r3f",
      "available": true,
      "path": "adapters/react-r3f",
      "entry": "adapters/react-r3f/src/main.jsx",
      "compatibility": {
        "react": ">=19 <20",
        "reactThreeFiber": ">=9 <10",
        "three": ">=0.185 <0.186",
        "vite": ">=8 <9"
      }
    }
  ],
  "assetSlots": [
    {
      "id": "hero-object",
      "type": "replaceable-media",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "state-copy",
      "type": "structured-content",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "state-materials",
      "type": "replaceable-media",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    },
    {
      "id": "state-camera-poses",
      "type": "motion-config",
      "required": true,
      "distribution": "replaceable-demo-included",
      "config": "adapters/react-r3f/src/template.config.js"
    }
  ],
  "compatibility": {
    "webmotion": ">=0.1.0",
    "browser": "Modern browser with WebGL2 recommended; readable fallback required",
    "framework": "Framework-neutral contract with a react-r3f adapter"
  },
