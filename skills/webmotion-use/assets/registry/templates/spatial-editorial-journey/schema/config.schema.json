{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webmotion.local/schemas/spatial-editorial-journey.config.schema.json",
  "title": "Spatial Editorial Journey configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "assets", "chapters", "traverse", "motion"],
  "properties": {
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "supported"],
      "properties": {
        "default": { "type": "string", "minLength": 2 },
        "supported": { "type": "array", "items": { "type": "string", "minLength": 2 }, "minItems": 1, "uniqueItems": true }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "traverse", "closing"],
      "properties": {
        "source": { "$ref": "#/$defs/asset" },
        "traverse": { "$ref": "#/$defs/asset" },
        "closing": { "$ref": "#/$defs/asset" },
        "favicon": { "$ref": "#/$defs/asset" },
        "fonts": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "traverse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter", "panels", "trackViewports"],
      "properties": {
        "chapter": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "panels": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/traversePanel" } },
        "trackViewports": { "type": "number", "minimum": 2, "maximum": 8 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakpoint", "desktop", "mobile", "damping", "reduced"],
      "properties": {
        "breakpoint": { "type": "number", "minimum": 320, "maximum": 1280 },
        "desktop": { "$ref": "#/$defs/trajectorySet" },
        "mobile": { "$ref": "#/$defs/trajectorySet" },
        "damping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camera", "lookAt"],
          "properties": {
            "camera": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "lookAt": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 }
          }
        },
        "reduced": { "enum": ["direct-progress", "stable-chapter-poses"] }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "license", "provenance"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "license": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "localized": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "composition", "title", "body", "fact"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "number": { "type": "string", "pattern": "^[0-9]{2}$" },
        "composition": {
          "enum": ["image-field", "horizontal-traverse", "coordinate-archive", "editorial-index", "particle-field", "geographic-plate", "return-field"]
        },
        "eyebrow": { "$ref": "#/$defs/localized" },
        "title": { "$ref": "#/$defs/localized" },
        "body": { "$ref": "#/$defs/localized" },
        "fact": { "type": "string", "minLength": 1 }
      }
    },
    "traversePanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "title", "body"],
      "properties": {
        "label": { "$ref": "#/$defs/localized" },
        "title": { "$ref": "#/$defs/localized" },
        "body": { "$ref": "#/$defs/localized" },
        "mediaSlot": { "type": "string" }
      }
    },
    "trajectorySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "traverse"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/cameraPose" },
            "end": { "$ref": "#/$defs/cameraPose" }
          }
        },
        "traverse": {
          "type": "object",
          "required": ["entryEnd", "start", "cruiseStart", "end"],
          "properties": {
            "entryEnd": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
            "start": { "$ref": "#/$defs/cameraPose" },
            "cruiseStart": { "$ref": "#/$defs/cameraOffsetPose" },
            "end": { "$ref": "#/$defs/cameraOffsetPose" }
          }
        }
      }
    },
    "cameraPose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "lookAt"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "lookAt": { "$ref": "#/$defs/vec3" }
      }
    },
    "cameraOffsetPose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "lookOffset"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "lookOffset": { "$ref": "#/$defs/vec3" }
      }
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
