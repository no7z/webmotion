{
  "version": 1,
  "previewPath": "/",
  "slots": [
    {
      "id": "hero-image",
      "label": {
        "zh": "首屏图片",
        "en": "Hero image"
      },
      "group": "images",
      "kind": "image",
      "value": "/images/hero.webp",
      "defaultValue": "/images/hero.webp",
