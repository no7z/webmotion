      "required": true,
      "source": "Project artwork",
      "license": "Project-owned",
      "fallback": "/images/hero-fallback.webp"
    },
    {
      "id": "product-model",
      "label": {
        "zh": "产品模型",
        "en": "Product model"
      },
      "group": "models",
      "kind": "model",
      "value": "/models/product.glb",
      "defaultValue": "/models/product.glb",
      "accept": [".glb"],
      "required": true,
      "source": "Project model",
      "license": "Project-owned",
      "fallback": "CSS silhouette"
    },
    {
      "id": "hero-title",
      "label": {
        "zh": "首屏标题",
        "en": "Hero title"
      },
      "group": "copy",
      "kind": "text",
      "value": {
        "zh": "让空间讲述产品",
        "en": "LET SPACE TELL THE STORY"
      },
