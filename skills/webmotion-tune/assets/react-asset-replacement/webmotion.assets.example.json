    {
      "id": "impact-distance",
      "label": {
        "zh": "影响距离",
        "en": "Impact distance"
      },
      "group": "display-metrics",
      "kind": "metric",
      "value": {
        "amount": "4,860",
        "unit": "m"
      },
      "defaultValue": {
        "amount": "4,860",
        "unit": "m"
      },
      "amountMaxLength": 24,
      "unitMaxLength": 12,
      "required": true
    }
  ]
